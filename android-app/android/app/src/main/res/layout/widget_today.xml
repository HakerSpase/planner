<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 4×2 «Сегодня»: слева серия, справа задачи дня -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/streak_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="СЕРИЯ" android:textColor="#FF6E6B7B" android:textSize="10sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/streak_flame" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/widget_flame_off" android:importantForAccessibility="no" />
            <TextView android:id="@+id/streak_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:text="0" android:textColor="#FFF4F2FA" android:textSize="36sp" />
        </LinearLayout>
        <TextView android:id="@+id/streak_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:text="открой Planner" android:textColor="#FF9A98A8" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot0" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot1" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot2" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot3" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot4" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot5" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                <ImageView android:id="@+id/dot6" android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/widget_dot_off" android:importantForAccessibility="no" />
                <TextView android:id="@+id/day6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="·" android:textColor="#FF6E6B7B" android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="СЕГОДНЯ" android:textColor="#FF6E6B7B" android:textSize="10sp" android:textStyle="bold" />

        <TextView android:id="@+id/stale_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="Открой Planner — здесь появится сводка дня" android:textColor="#FF9A98A8" android:textSize="13sp" android:visibility="gone" />

        <LinearLayout android:id="@+id/tasks_block" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="bottom" android:orientation="horizontal">
                <TextView android:id="@+id/tasks_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:text="0 из 0" android:textColor="#FFF4F2FA" android:textSize="20sp" />
                <TextView android:id="@+id/tasks_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" android:text="задач" android:textColor="#FF9A98A8" android:textSize="12sp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/tasks_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="1" android:progress="0" android:progressDrawable="@drawable/widget_progress" />
            <ProgressBar android:id="@+id/tasks_progress_done" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="1" android:progress="1" android:progressDrawable="@drawable/widget_progress_done" android:visibility="gone" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:fontFamily="sans-serif-medium" android:text="18:00" android:textColor="#FFB49CFF" android:textSize="13sp" />
                <TextView android:id="@+id/next_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Ближайших дел по времени нет" android:textColor="#FFE8E6F0" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/chip_overdue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/widget_chip_warn" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:maxLines="1" android:text="0 просрочено" android:textColor="#FFFF8F9E" android:textSize="11sp" android:visibility="gone" />
                <TextView android:id="@+id/chip_cards" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_chip" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:maxLines="1" android:text="0 карточек" android:textColor="#FFC9B8FF" android:textSize="11sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
